# RPC Endpoint công khai để đọc dữ liệu từ Ethereum Sepolia (không cần ví MetaMask)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# (Nâng cấp 1: Tùy chọn) Pinata API JWT để pin file lên mạng IPFS thực tế
# Đăng ký miễn phí tại https://app.pinata.cloud/developers/api-keys
# Nếu để trống, hệ thống tự động băm mã IPFS CIDv0 chuẩn trên client
VITE_PINATA_JWT=

# Gateway IPFS mặc định để tải và xem trước file
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
