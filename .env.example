# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO COPYRIGHTCHAIN
# Sao chép file này thành .env và điền thông tin thực tế
# LƯU Ý: TUYỆT ĐỐI KHÔNG DÙNG VÍ CHỨA TIỀN THẬT (MAINNET)!
# ==========================================

# URL RPC mạng Ethereum Sepolia (Lấy miễn phí từ Alchemy, Infura, QuickNode,...)
# Ví dụ Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key của ví MetaMask dùng cho mạng thử nghiệm Sepolia (có thể có hoặc không có tiền tố 0x)
# CẢNH BÁO: Chỉ dùng ví phụ chuyên để test, không lưu trữ tài sản thật!
PRIVATE_KEY=your_private_key_here

# API Key Etherscan (Tùy chọn - dùng nếu muốn verify mã nguồn contract trên Sepolia Etherscan)
# Lấy miễn phí tại: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
